@media (max-width: 760px) {
    .sa-dashboard .dash-hero {
        align-items: flex-start;
        flex-direction: column;
        padding: 24px 20px;
        border-radius: 17px;
    }
    .sa-dashboard .hero-action { margin-top: 2px; }
    .sa-dashboard .stats-grid { grid-template-columns: 1fr; gap: 12px; }
    .sa-dashboard .stat-card {
        display: grid;
        grid-template-columns: 1fr auto;
        align-items: center;
        padding: 18px;
    }
    .sa-dashboard .stat-top { display: contents; }
    .sa-dashboard .stat-label { align-self: end; }
    .sa-dashboard .stat-icon {
        grid-column: 2;
        grid-row: 1 / span 2;
    }
    .sa-dashboard .stat-number {
        margin-top: 8px;
        font-size: 29px;
    }
    .sa-dashboard .stat-foot { grid-column: 1 / -1; }
    .sa-dashboard .content-grid { grid-template-columns: 1fr; }
}
