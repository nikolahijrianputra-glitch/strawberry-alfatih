    color: #8e2942;
    background: rgba(255,255,255,.3);
}

.hero-editorial .hero-editorial-photo {
    width: 100%;
    min-width: 0;
    height: 100%;
    min-height: 470px;
    aspect-ratio: auto;
    justify-self: stretch;
    align-self: stretch;
