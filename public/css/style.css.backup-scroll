    top: 4px;
    left: 4px;
    width: 2px;
    height: 4px;
    border-radius: 2px;
    background: #a01e3c;
    animation: editorial-scroll 1.5s ease-in-out infinite;
}

@keyframes editorial-scroll {
    0%, 100% { transform: translateY(0); opacity: 1; }
    70% { transform: translateY(5px); opacity: .3; }
}

@media (min-width: 1500px) {
