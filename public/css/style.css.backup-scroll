    border: 0;
    border-radius: 0;
    box-shadow: none;
    animation: none;
}

.hero-editorial .hero-editorial-photo img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 470px;
    object-fit: cover;
    object-position: center;
}

.hero-editorial .hero-scroll-hint {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 34px;
    color: #9b656c;
    font-size: 10px;
    text-decoration: none;
