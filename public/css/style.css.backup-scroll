.hero-editorial-inner {
    width: min(1440px, 100% - 64px);
    min-height: 470px;
    margin-inline: auto;
    display: grid;
    grid-template-columns: .92fr 1.08fr;
    align-items: stretch;
    gap: clamp(28px, 4vw, 64px);
}

.hero-editorial .hero-editorial-text {
