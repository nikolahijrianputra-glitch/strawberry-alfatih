/* ===== PREMIUM STRAWBERRY STATISTICS ===== */
.stats-section {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 62px 24px;
    background:
        radial-gradient(ellipse at 10% 0%, rgba(236, 72, 115, .09), transparent 42%),
        radial-gradient(ellipse at 90% 100%, rgba(255, 190, 205, .22), transparent 42%),
        linear-gradient(135deg, #fff5f6 0%, #fffafb 50%, #fff0f3 100%);
    border-top: 1px solid rgba(190, 39, 81, .10);
    border-bottom: 1px solid rgba(190, 39, 81, .10);
}

.stats-section::before,
.stats-section::after {
    content: "";
    position: absolute;
    z-index: -1;
    width: 180px;
    height: 180px;
    border: 1px solid rgba(190, 39, 81, .10);
    border-radius: 50%;
    pointer-events: none;
}

.stats-section::before {
    top: -115px;
    left: -55px;
    box-shadow: 0 0 0 18px rgba(190, 39, 81, .025),
                0 0 0 38px rgba(190, 39, 81, .02);
}

.stats-section::after {
    bottom: -130px;
    right: -45px;
    box-shadow: 0 0 0 18px rgba(190, 39, 81, .025),
                0 0 0 38px rgba(190, 39, 81, .02);
}

.stats-container {
    position: relative;
    z-index: 1;
    max-width: 1120px;
    margin: auto;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
}

.stats-container .stat-item {
    position: relative;
    padding: 14px 24px;
    transition: transform .3s ease;
}

.stats-container .stat-item + .stat-item::before {
    content: "";
    position: absolute;
    top: 20%;
    bottom: 20%;
    left: 0;
    width: 1px;
    background: linear-gradient(
        to bottom,
        transparent,
        rgba(190, 39, 81, .25),
        transparent
    );
}

.stats-container .stat-item:hover {
    transform: translateY(-5px);
}

.stats-container .stat-item h2 {
    display: flex;
    justify-content: center;
    align-items: baseline;
    gap: 3px;
    margin: 0 0 13px;
    color: #bd2851;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(34px, 4vw, 48px);
    font-weight: 700;
    letter-spacing: -1.5px;
    line-height: 1.15;
}

.stats-container .stat-item h2::after {
    content: "";
    display: block;
    width: 22px;
    height: 3px;
    position: absolute;
    bottom: 4px;
    left: 50%;
    transform: translateX(-50%);
    border-radius: 10px;
    background: #e8a0b1;
    opacity: .8;
}

.stats-container .stat-item p {
    margin: 0;
    color: #79535e;
    font-size: 15px;
    font-weight: 500;
    letter-spacing: .3px;
    line-height: 1.6;
}

@media (max-width: 600px) {
    .stats-section {
        padding: 36px 8px;
    }

    .stats-container .stat-item {
        padding: 12px 3px;
    }

    .stats-container .stat-item h2 {
        font-size: clamp(23px, 6vw, 32px);
        letter-spacing: -1px;
        margin-bottom: 12px;
    }

    .stats-container .stat-item h2::after {
        width: 15px;
        height: 2px;
    }

    .stats-container .stat-item p {
        font-size: 11px;
        letter-spacing: 0;
    }
}

@media (prefers-reduced-motion: reduce) {
    .stats-container .stat-item {
        transition: none;
    }
}
/* Typography statistik: elegan dan natural */
.stats-container .stat-item h2 {
    font-family: inherit !important;
    font-size: clamp(36px, 3.2vw, 44px) !important;
    font-weight: 600 !important;
    letter-spacing: -1.8px !important;
    line-height: 1.2;
    color: #b72d50;
    font-variant-numeric: tabular-nums;
}

.stats-container .stat-item p {
    font-family: inherit !important;
    font-size: 14px !important;
    font-weight: 400 !important;
    letter-spacing: 0 !important;
    color: #795b63;
}

@media (max-width: 600px) {
    .stats-container .stat-item h2 {
        font-size: clamp(24px, 6vw, 32px) !important;
        letter-spacing: -1px !important;
    }

    .stats-container .stat-item p {
        font-size: 11px !important;
    }
}

