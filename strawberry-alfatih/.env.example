APP_NAME="Strawberry Alfatih"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://strawberry-alfatih.test

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Database MySQL/MariaDB (Laragon: user root, password kosong) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=strawberry_alfatih
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production dengan HTTPS: aktifkan baris berikut
# SESSION_SECURE_COOKIE=true

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# --- Data toko ---
# Nomor WhatsApp format internasional tanpa "+" (0853-7474-8715 -> 6285374748715)
STORE_WHATSAPP=6285374748715
# Isi setelah data asli tersedia (kosong = tidak tampil di footer)
STORE_ADDRESS=
STORE_MAPS_URL=
# Set true di production (HTTPS)
FORCE_HTTPS=false
